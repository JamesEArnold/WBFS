{
  "name": "wbfs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.3 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "postbuild": "next-sitemap --config next-sitemap.config.cjs",
    "dev:op": "op run --env-file=.env.op -- next dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e:install": "playwright install chromium",
    "test:e2e": "playwright test --project=smoke --project=text",
    "test:visual": "playwright test --project=visual-mobile --project=visual-desktop",
    "test:visual:update": "playwright test --project=visual-mobile --project=visual-desktop --update-snapshots",
    "test:text:update": "playwright test --project=text --update-snapshots",
    "db:local:up": "docker compose up -d postgres",
    "db:local:down": "docker compose down",
    "payload": "payload",
    "payload:generate:types": "payload generate:types",
    "payload:generate:importmap": "payload generate:importmap",
    "payload:migrate:create": "payload migrate:create",
    "payload:migrate": "payload run scripts/env-guard.ts && payload migrate",
    "seed": "payload run scripts/seed.ts",
    "users:bootstrap-admin": "payload run scripts/bootstrap-admin.ts",
    "db:reset:test": "payload run scripts/reset-test-db.ts && npm run payload:migrate && npm run seed",
    "test:cms": "playwright test --project=cms",
    "vercel-build": "payload run scripts/vercel-prebuild.ts && npm run build"
  },
  "dependencies": {
    "@hookform/resolvers": "3.10.0",
    "@payloadcms/db-postgres": "3.94.1",
    "@payloadcms/next": "3.94.1",
    "@payloadcms/richtext-lexical": "3.94.1",
    "@payloadcms/storage-vercel-blob": "3.94.1",
    "@payloadcms/ui": "3.94.1",
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-icons": "1.3.2",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-slot": "1.5.0",
    "@vercel/analytics": "1.6.1",
    "@vercel/speed-insights": "1.3.1",
    "autoprefixer": "10.4.14",
    "axios": "1.21.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "graphql": "16.15.0",
    "next": "16.4.6",
    "next-sitemap": "^4.2.3",
    "payload": "3.94.1",
    "postcss": "8.4.27",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "react-spinners": "0.17.1",
    "react-toastify": "11.2.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "tailwind-merge": "^1.14.0",
    "tailwindcss": "3.3.3",
    "tailwindcss-animate": "^1.0.6",
    "zod": "^3.21.4"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  },
  "optionalDependencies": {
    "@rolldown/binding-darwin-arm64": "1.2.19"
  }
}
