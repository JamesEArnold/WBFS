# 1Password secret references (no secret values in this file).
# Used via: op run --env-file=.env.op -- <command>   (wrapped by npm scripts)
# Adjust the vault/item paths to match the 1Password vault that holds WBFS secrets.

SENDGRID_SECRET=op://WBFS/SendGrid/credential
SENDGRID_MAILING_ID=op://WBFS/SendGrid/mailing_list_id
SENDGRID_VOLUNTEER_ID=op://WBFS/SendGrid/volunteer_list_id
