# Variable names only — never put real values here.
# Local dev values live in .env.development (local Docker DB, not secrets).
# Deployed values are set per Vercel environment (Production / Preview) and mirrored in 1Password.

# Environment identity (checked by scripts/env-guard.ts before any data script)
APP_ENV=                 # local | preview | production
EXPECTED_DB_ENDPOINT=    # local: 127.0.0.1:54329 · Neon: the ep-… endpoint id of this env's branch

# Payload CMS
DATABASE_URI=            # Postgres connection string (Neon branch for preview/production)
PAYLOAD_SECRET=          # long random string, different per environment
NEXT_PUBLIC_SERVER_URL=  # e.g. https://weisburnforsheriff.com
BLOB_READ_WRITE_TOKEN=   # Vercel Blob store token (unset locally → uploads go to ./media)
BLOB_PUBLIC_HOST=        # e.g. abc123.public.blob.vercel-storage.com (allows next/image)

# SendGrid (mailing list + volunteer signup forms)
SENDGRID_SECRET=
SENDGRID_MAILING_ID=
SENDGRID_VOLUNTEER_ID=
